# Copie este archivo como .env (en la misma carpeta) y complete sus claves.
# El archivo .env NO se sube a GitHub (está en .gitignore).
# Si deja un bloque vacío, ese canal funciona en modo simulado.

# --- Seguridad (cámbielos antes de desplegar) ---
JWT_SECRET=cambie-este-secreto-por-uno-largo-y-aleatorio
FILE_ENCRYPTION_KEY=clave-para-cifrado-aes-256-de-archivos-clinicos

# --- Correo real (Gmail con "contraseña de aplicación") ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Clínica Odontológica Sonrisa Integral

# --- SMS y WhatsApp reales (Twilio, cuenta de prueba gratuita) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número de Twilio para SMS, formato +1XXXXXXXXXX
TWILIO_SMS_FROM=
# Número del sandbox de WhatsApp de Twilio (normalmente +14155238886)
TWILIO_WHATSAPP_FROM=
DEFAULT_COUNTRY_CODE=+593

# --- Pagos con tarjeta (Stripe, clave secreta de modo prueba: sk_test_...) ---
STRIPE_SECRET_KEY=

# --- Solo para ejecutar el backend sin Docker ---
# DATABASE_URL=postgres://sigo:sigo_dental_2026@localhost:5435/sigo_dental?sslmode=disable
# APP_TIMEZONE=America/Guayaquil
